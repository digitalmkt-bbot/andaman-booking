# ---- Core ----
# PostgreSQL connection string. On Railway this is provided automatically as
# ${{ Postgres.DATABASE_URL }}. For local dev with docker-compose use:
DATABASE_URL="postgresql://andaman:andaman@localhost:5432/andaman?schema=public"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:5173"
TZ="Asia/Bangkok"

# Reminder lead time (minutes before start) for upcoming-booking notifications
REMINDER_LEAD_MINUTES=30

# ---- Integrations (optional; leave blank to disable) ----
# Email (SMTP via nodemailer). Install: npm i nodemailer
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Andaman Booking <no-reply@example.com>"

# LINE Messaging API
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=

# Google Calendar (service account or OAuth). Install: npm i googleapis
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=

# Microsoft Outlook / Graph
OUTLOOK_ENABLED=false
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_USER_ID=
